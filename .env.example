APP_NAME=Official Letter Reference Extractor
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LANG=th
ENABLE_AUTH=false
APP_TOKEN=
SECRET_KEY=change-me-to-a-long-random-secret
LOG_LEVEL=INFO
SESSION_COOKIE_NAME=olre_session
SESSION_MAX_AGE_SECONDS=28800

# SQLite-first zero-setup runtime
DATABASE_URL=sqlite:////app/data/olre.sqlite3
INPUT_DIR=/app/data/input
PROCESSED_DIR=/app/data/processed
ERROR_DIR=/app/data/error
QR_DEBUG_DIR=/app/data/debug/qr

OCR_ENABLED=false
OCR_ENGINE=tesseract
OCR_LANG=tha+eng
OCR_TIMEOUT_SECONDS=30
OCR_MIN_TEXT_CHARS=25
OCR_DPI_SCALE=3
OCR_PAGE_SEGMENTATION_MODE=6
QR_DEBUG_EXPORT=false
QR_DEBUG_RETENTION_HOURS=72
QR_FALLBACK_DECODER=none
URL_RESOLVE_TIMEOUT_SECONDS=5
URL_RESOLVE_MAX_ATTEMPTS=2
URL_RESOLVE_USER_AGENT=OLRE/0.1 URL Resolver
FILE_RETENTION_MODE=retain_failed_only
SUCCESS_SOURCE_RETENTION_HOURS=0
FAILED_SOURCE_RETENTION_HOURS=168
SOURCE_DELETE_ON_CACHE_REUSE=true
CLEANUP_ENABLED=true
CLEANUP_INTERVAL_MINUTES=60
CLEANUP_STARTUP_SWEEP=true
DEFAULT_FORCE_REPROCESS=false
EXTRACTION_VERSION=1
TEMP_FILE_MAX_AGE_HOURS=24
RUNTIME_TMP_DIR=/app/data/runtime/tmp
FAILED_RETAINED_DIR=/app/data/runtime/failed-retained

# Future profile notes only. These are not required for the default Docker runtime.
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/database
# MARIADB_HOST=127.0.0.1
# MARIADB_PORT=3306
# MARIADB_DB=hr
# MARIADB_USER=readonly_user
# MARIADB_PASSWORD=change-me
